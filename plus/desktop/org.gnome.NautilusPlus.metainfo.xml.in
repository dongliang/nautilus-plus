<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@appid@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>nautilus-plus</name>
  <name xml:lang="zh_CN">文件管理器增强版</name>
  <summary>Access and organize files</summary>
  <summary xml:lang="zh_CN">访问和组织你的文件</summary>
  <description>
    <p>
      nautilus-plus is a fork of Files (Nautilus), the file manager of the GNOME desktop.
      It provides a simple and integrated way of managing your files and browsing your file system.
    </p>
    <p>
      This fork adds project-folder enhancements on top of the original file manager:
      Chinese display names read from .project.yaml metadata, project status markers and
      collapsible grouped views.
    </p>
    <p>
      nautilus-plus 是 GNOME 桌面文件管理器 Files(nautilus)的增强版 fork,
      提供简单、整合的方式管理你的文件并浏览文件系统。本 fork 在原生文件管理器之上
      增加了项目文件夹增强:读取 .project.yaml 元数据显示中文名、项目状态标记,
      以及可折叠的分组视图。
    </p>
  </description>
  <url type="bugtracker">https://gitlab.gnome.org/GNOME/nautilus/issues</url>
  <url type="contact">https://discourse.gnome.org/tag/nautilus</url>
  <url type="homepage">https://apps.gnome.org/Nautilus/</url>
  <launchable type="desktop-id">@appid@.desktop</launchable>
  <releases>
    <release version="@release-version@" date="2026-08-19"/>
  </releases>
</component>