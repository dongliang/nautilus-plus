<?xml version="1.0" encoding="UTF-8"?>
<!-- Fork-only settings for nautilus-plus.

     These must NOT live in the upstream org.gnome.nautilus.gschema.xml:
     that file is owned by the distribution's nautilus package, so a system
     upgrade overwrites it and silently drops fork-only keys. Reading a
     missing key aborts the process (g_error), taking the whole file manager
     down. Keeping our keys in this separately-named file means package
     upgrades cannot touch them. See plus/docs/pitfalls.md. -->
<schemalist>
  <schema path="/org/gnome/NautilusPlus/preferences/" id="org.gnome.NautilusPlus.preferences">
    <key type="b" name="hide-archived">
      <default>false</default>
      <summary>Hide archived folders</summary>
      <description>Hide folders whose "group" extension attribute marks them as archived (written by project-name-zh.py). The stock nautilus ignores this key.</description>
    </key>
  </schema>
</schemalist>
